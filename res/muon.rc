#include <winver.h>
#include "../src/version.h"

1 ICON "muon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MUON_VERSION_MAJOR, MUON_VERSION_MINOR, MUON_VERSION_PATCH, 0
 PRODUCTVERSION MUON_VERSION_MAJOR, MUON_VERSION_MINOR, MUON_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Muon photo editor"
            VALUE "FileVersion", MUON_VERSION_STR
            VALUE "InternalName", "Muon"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Muon.exe"
            VALUE "ProductName", "Muon"
            VALUE "ProductVersion", MUON_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
